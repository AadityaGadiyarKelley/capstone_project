print(f"Shape of each window: {all_windows[0].shape}")

# Create simple labels based on position in engine's lifetime
labels = []

for engine_id in train_data['engine_id'].unique():
    engine_data = train_data[train_data['engine_id'] == engine_id]
    engine_length = len(engine_data)
    num_windows = engine_length - 30 + 1
    
    # Last 30 windows = anomalous (near failure)
    # Everything else = normal
    engine_labels = [0] * (num_windows - 30) + [1] * min(30, num_windows)
    labels.extend(engine_labels)

labels = np.array(labels)
print(f"Normal windows (label 0): {sum(labels == 0)}")
print(f"Anomalous windows (label 1): {sum(labels == 1)}")

# Reshape windows from (17000, 30, 21) to (17000, 630)
