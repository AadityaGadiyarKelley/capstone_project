# Sliding window for one engine
def create_windows(engine_data, window_size=30):
    windows = []
    for i in range(len(engine_data) - window_size + 1):
        # Get sensor columns only (skip engine_id, cycle, settings)
        sensor_cols = [col for col in engine_data.columns if col.startswith('sensor_')]
        window = engine_data[sensor_cols].iloc[i:i+window_size].values
        windows.append(window)
    return np.array(windows)

# Test on engine 1
engine_1_windows = create_windows(engine_1_data, window_size=30)
print(f"Created {len(engine_1_windows)} windows")
print(f"Each window shape: {engine_1_windows[0].shape}")  # Should be (30, 21) - 30 timesteps, 21 sensors

# Compare first window (healthy) vs last window (near failure)
